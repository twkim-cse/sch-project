# docker-compose 실행 시 사용하는 루트 공통 설정.
# 실제 값은 .env 파일에 넣고 커밋하지 않는다.

# AI 모델 호출용 API 키 (ai 서버로 전달됨)
AI_MODEL_API_KEY=

# 서버 주소 (참고용 기본값 - docker-compose.yml에서 실제로 주입됨)
BACKEND_PORT=8080
AI_PORT=8001
FRONTEND_PORT=5173
AI_BASE_URL=http://ai:8001

# true(기본값)이면 문서 업로드/조회 API(F-02/F-04)가 실제 PDF를 분석하지 않고
# 어떤 PDF를 올려도 명세서 예시와 같은 고정 결과(READY, 예시 특약 목록)를 돌려준다.
# 실제 약관 PDF 없이 프론트 화면을 만들 때 켜 둔다. 실제 분석을 확인하려면 false로 바꾼다.
MOCK_DOCUMENTS=true
